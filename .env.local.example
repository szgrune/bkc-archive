# Copy this file to .env.local and fill in the values from your Sanity project.
# Find these at https://sanity.io/manage (or run `npx sanity init` inside ./studio).

# --- Public (used by the Next.js frontend AND the Studio) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# --- Server-only: write token for seeding/importing content ---
# Create at sanity.io/manage -> your project -> API -> Tokens (Editor or higher).
# NEVER commit the real token. Used by `npm run seed`.
SANITY_API_WRITE_TOKEN=
