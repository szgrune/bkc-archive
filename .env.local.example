# Copy this file to .env.local. The project ID and dataset below point at the
# shared BKC Archive Sanity project — leave them as-is. You only need to add
# your own write token (last line) if you plan to seed content from code.

# --- Public (used by the Next.js frontend AND the Studio) ---
# Project IDs are not secret (they ship in the frontend bundle), so they live here.
NEXT_PUBLIC_SANITY_PROJECT_ID=lwvigy05
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# --- Server-only: write token for seeding/importing content ---
# Create at sanity.io/manage -> your project -> API -> Tokens (Editor or higher).
# NEVER commit the real token. Used by `npm run seed`.
SANITY_API_WRITE_TOKEN=
