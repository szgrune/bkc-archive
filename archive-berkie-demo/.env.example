# LLM Engine credentials (the admin account you created at first startup)
LLM_ENGINE_URL=http://localhost:3000
LLM_ENGINE_USERNAME=admin
LLM_ENGINE_PASSWORD=changeme

# Bedrock
LLM_PLATFORM=bedrock
LLM_MODEL=anthropic.claude-sonnet-4-6-20251001-v1:0

# Slack app credentials
# Channel ID: right-click channel in Slack → Copy link → last segment (C0XXXXXXXXX)
SLACK_CHANNEL_ID=C0XXXXXXXXX
SLACK_WORKSPACE=berkman-klein
# Bot User OAuth Token from api.slack.com/apps → OAuth & Permissions
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
# Bot display name (must match the Slack app name)
SLACK_BOT_NAME=archive-berkie

# Path to the archive JSON (clone szgrune/bkc-archive-wiki and point here)
ARCHIVE_PATH=./raw/archive.json

# Output directory for generated PDFs before upload
PDF_OUTPUT_DIR=./pdfs

# Written by setup.mjs — used by upload-pdfs.mjs
# CONVERSATION_ID=
