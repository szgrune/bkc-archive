# Copy to studio/.env and fill in. The projectId MUST match the one in the
# root .env.local (NEXT_PUBLIC_SANITY_PROJECT_ID) so the app and Studio point
# at the same Sanity project.
#
# Only SANITY_STUDIO_*-prefixed vars are exposed to the Studio bundle.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
